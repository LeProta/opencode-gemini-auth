{
  "name": "opencode-gemini-auth",
  "version": "2.3.1",
  "author": "jenslys",
  "repository": "https://github.com/LeProta/opencode-gemini-auth",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "types": "tsc --noEmit",
    "bundle": "tsup",
    "smoke:node-import": "node -e \"Promise.all([import('opencode-gemini-auth'), import('opencode-gemini-auth/server')]).then(() => console.log('ok')).catch((error) => { console.error(error); process.exit(1); })\"",
    "prepublishOnly": "bun run bundle && bun run smoke:node-import",
    "check:cliproxy": "node commands/check-cliproxy.mjs",
    "lint": "biome lint",
    "check": "bun run types && bun run lint && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/bun": "latest",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.14"
  }
}
